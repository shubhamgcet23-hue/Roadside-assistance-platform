# Server
PORT=5000
NODE_ENV=development

# MongoDB: local (docker compose up -d) or an Atlas connection string
# Local:  mongodb://127.0.0.1:27017/roadside_aaa
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roadside_aaa?retryWrites=true&w=majority
MONGODB_URI=

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed browser origin(s), comma separated. Use your Vercel/Netlify URL in production (no trailing slash).
CLIENT_URL=http://localhost:5173

# Optional tuning
AVG_SPEED_KMH=30
OFFER_TIMEOUT_SECONDS=300
ENABLE_DEMO_TRACKING=true

# Seed: partners are scattered around this point (defaults to Greater Noida). Set it to where you will demo.
SEED_CENTER_LAT=28.4744
SEED_CENTER_LNG=77.5040
