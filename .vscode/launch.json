    {
      "name": "Debug seed script",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/utils/seed.js",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal"
    }
  ]
}
